# GoHighLevel integration for site forms.
# Set these in Vercel → Project → Settings → Environment Variables.
# Real values must NEVER be committed — .env / .env.local are gitignored.

# Private Integration Token (pit-…) for your GHL sub-account.
# IMPORTANT: rotate any token that was ever shared in plaintext.
GHL_API_KEY=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Your GHL sub-account (location) id.
GHL_LOCATION_ID=

# Optional — set to a GHL user id to attach a details note to each contact.
GHL_USER_ID=

# Optional — GHL custom-field ids for job title, department and industry.
# GHL has no standard contact field for these three, so the forms write them
# as custom fields. Leave them BLANK and the ids are looked up from the
# location itself (matched on field key, then on field name), which is the
# normal case: create "Job Title", "Department" and "Industry" custom fields
# in GHL and nothing else is needed. Set an id here only when a location
# names its field something the lookup would not find. With no such custom
# fields at all the values still reach the note and site_form_submissions.
GHL_CF_TITLE=
GHL_CF_DEPARTMENT=
GHL_CF_INDUSTRY=

# ─────────────────────────────────────────────────────────────────────────────
# Supabase — backs the dynamic Events + Blog posts submitted via the n8n form.
# The SITE uses the public anon key (read-only; RLS allows SELECT of published
# rows). The n8n workflow uses the SERVICE ROLE key (server-side only — NEVER
# put the service role key in any VITE_ var or the browser bundle).
# Without these the site falls back to the curated static events/blog content.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# CMS content editor (/admin/content) — server-side only.
# The editor-gated /api/admin/* functions write with the SERVICE ROLE key after
# verifying the signed-in editor (Supabase Auth + the public.editors allow-list).
# NEVER expose the service role key to the browser (no VITE_ prefix). Also used
# by the analytics endpoint.
SUPABASE_SERVICE_ROLE_KEY=
# Google Gemini API key — used ONLY by /api/admin/kb-ingest to re-embed edited
# EVan knowledge-base documents (gemini-embedding-001, 3072-dim). Server-only.
GEMINI_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Google reCAPTCHA v3 — invisible spam scoring on all forms.
# Create keys at https://www.google.com/recaptcha/admin (choose "Score based v3").
# Site key is public (ships in the browser); secret key is server-only.
# Leave both blank to disable verification (forms still work).
VITE_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ── Event submissions (/list-your-event) ──────────────────────────────────────
# A submission becomes a DRAFT event in site_events (reviewable in
# /admin/content/events) and posts one Slack message with Approve / Reject links.
# Requires migration 0025_event_submissions.sql.

# Signs the Approve / Reject links in that Slack message. NO FALLBACK: without
# it the links would be forgeable by anyone who reads api/_event-submission.ts,
# so the buttons are simply not rendered and the CMS stays the way in.
# Generate one with:  openssl rand -base64 32
EVENT_REVIEW_SECRET=

# Absolute base URL used to build the Approve / Reject links and the event link
# in the organiser's approval email. Defaults to https://electrifyingtheus.com.
PUBLIC_SITE_URL=https://electrifyingtheus.com

# Where the submission notification goes. Already used for lead alerts; the
# event message replaces the generic one so a submission is not posted twice.
SLACK_WEBHOOK_URL=

# NOTE: the "your event is live" email goes out through RESEND_API_KEY /
# RESEND_FROM — the same sender api/share-email.ts already uses. No extra API
# scope is needed, which is why it is Resend and not the GoHighLevel
# Conversations API. The GHL contact is still tagged "event-approved"
# best-effort so a workflow can hang off it later. If the send fails,
# publishing still works and the reason is recorded in
# site_event_submissions.approval_email_error.

# Who gets pinged in the Slack event-submission message. MUST be Slack member
# IDs, not names — "@carlos" is plain text and notifies nobody, which is the
# failure mode that looks like it worked.
# Find an ID in Slack: profile -> More (...) -> Copy member ID.
#   SLACK_REVIEW_MENTIONS="<@U01ABC2DEF> <@U03GHI4JKL> <@U05MNO6PQR>"
# Unset means no mention line rather than a broken one.
SLACK_REVIEW_MENTIONS=
